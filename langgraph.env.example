# Add the desired settings to the existing .env; do not replace that file.
# n8n keeps the current webhook and credentials. Chat still runs through LangGraph.
TIMO_CHAT_PROVIDER=n8n

# For model-selected tool calling, change the provider to groq and configure:
# TIMO_CHAT_PROVIDER=groq
# GROQ_API_KEY=<your private key, saved locally>
# TIMO_GROQ_MODEL=<exact tool-calling model ID from your Groq account>

# Default persistent checkpoint database: data/chat_graph.db
# TIMO_GRAPH_DB=<optional absolute local database path>
