# Copy to .env. Never commit the .env file.
# n8n works without a Groq chat-model ID; import the example workflow first.
TIMO_CHAT_PROVIDER=n8n
N8N_PRIME_WEBHOOK_URL=http://127.0.0.1:5678/webhook/htn-prime-chat

# Groq STT keeps uploaded audio in memory; no local model download is required.
TIMO_STT_PROVIDER=groq
GROQ_API_KEY=
TIMO_GROQ_STT_MODEL=whisper-large-v3
TIMO_STT_DEBUG=0

# Optional direct Groq chat with model-selected tools:
# TIMO_CHAT_PROVIDER=groq
# TIMO_GROQ_MODEL=<available tool-calling model ID from your Groq account>

# Optional local STT (install requirements-local-stt.txt first):
# TIMO_STT_PROVIDER=local
# TIMO_STT_MODEL=small
# TIMO_STT_DEVICE=cpu
# TIMO_STT_COMPUTE_TYPE=int8

# Optional paths for existing deployments. Defaults are inside this checkout.
# TIMO_CATALOG_DB=C:/private-timo/products.db
# TIMO_AGENT_DB=C:/private-timo/agent.db
# TIMO_GRAPH_DB=C:/private-timo/chat_graph.db
# TIMO_AGENT_ADMIN_KEY=<optional private operator key>
# TIMO_ADB_PATH=C:/platform-tools/adb.exe
# TIMO_ADB_DEVICE=<adb device serial>
